{
  "name": "music-link",
  "version": "0.0.0",
  "description": "A public-share player for Navidrome",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --environment node",
    "typecheck": "tsc --noEmit",
